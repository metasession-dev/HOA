NEXT_PUBLIC_API_URL=http://localhost:3003
PORT=3002

# Cross-app URLs — the role-switcher JWT hand-off, "copy invite link" in the
# admin console, and resale access links all build on these. Read in exactly
# one place, src/lib/app-urls.ts; never read them at a call site.
#
# Note the PLURAL name. A `NEXT_PUBLIC_RESIDENT_URL` (singular) briefly
# existed at a few call sites, was never set anywhere, and silently fell
# through to localhost in production. Do not reintroduce it.
NEXT_PUBLIC_ENTERPRISE_URL=http://localhost:3002
NEXT_PUBLIC_RESIDENTS_URL=http://localhost:3005

# Marketing site URL — used by the auth pages' "Back to hoa.africa" link.
# Leave empty in dev to hide the link entirely.
NEXT_PUBLIC_MARKETING_URL=http://localhost:8080

# Observability — leave empty to disable.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENV=
NEXT_PUBLIC_SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1

NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
